# LLM Provider（OpenAI-compatible）
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max-preview
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SEC=180
LLM_MAX_ATTEMPTS=2

# Server
HOST=127.0.0.1
PORT=8765

# Debug — save LLM prompts/responses to debug_sessions/
LLM_DEBUG=0
# LLM_DEBUG_DIR=./debug_sessions

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/cad_agent.db

# Conversation
CONVERSATION_BUDGET_CHARS=120000
# CHAT_PLAN_MODE_DEFAULT=1

# Vision（空白视口也会多一次慢调用；默认关，面板可再开）
VISION_ENABLED=0
# VISION_API_KEY=
# VISION_BASE_URL=
VISION_MODEL=qwen3.8-max-preview
# VISION_MAX_EDGE=1024
