# LLM Provider（OpenAI-compatible）
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# max_tokens=输出预算；推理模型的 thinking 也算在内，别给太小
LLM_MAX_TOKENS=16384
LLM_TIMEOUT_SEC=180
LLM_MAX_ATTEMPTS=2

# Server
HOST=127.0.0.1
PORT=8765

# Debug — save LLM prompts/responses to debug_sessions/
LLM_DEBUG=0
# LLM_DEBUG_DIR=./debug_sessions

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/cad_agent.db

# Conversation
CONVERSATION_BUDGET_CHARS=120000
# CHAT_PLAN_MODE_DEFAULT=1

# Vision（空白视口也会多一次慢调用；默认关，面板可再开）
# 若主模型本身多模态（如 deepseek-flash），把下面三项指到同一模型即可
VISION_ENABLED=0
# VISION_API_KEY=
# VISION_BASE_URL=
VISION_MODEL=deepseek-flash
# VISION_MAX_EDGE=1024
