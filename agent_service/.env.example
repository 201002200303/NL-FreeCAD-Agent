# LLM Provider（OpenAI-compatible）
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# max_tokens = 单次**输出**上限（不是上下文窗口），且**含推理 token**：
# 推理模型（deepseek-flash）的 thinking 与正式 JSON 共享这份预算。
# 端点实测上限 393216；给低了会被思考烧光、JSON 截断 → 面板报「LLM 调用失败」。
LLM_MAX_TOKENS=393216
# 预算大 → 单轮更久（实测 16k token ≈ 83s），超时必须同步放大
LLM_TIMEOUT_SEC=600
LLM_MAX_ATTEMPTS=2

# Server
HOST=127.0.0.1
PORT=8765

# Debug — save LLM prompts/responses to debug_sessions/
LLM_DEBUG=0
# LLM_DEBUG_DIR=./debug_sessions

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/cad_agent.db

# Conversation
# 输入侧预算（字符），管每轮塞多少历史+文档上下文；与 max_tokens（单次输出）无关
CONVERSATION_BUDGET_CHARS=400000
# CHAT_PLAN_MODE_DEFAULT=1

# Vision（空白视口也会多一次慢调用；默认关，面板可再开）
# 若主模型本身多模态（如 deepseek-flash），把下面三项指到同一模型即可
VISION_ENABLED=0
# VISION_API_KEY=
# VISION_BASE_URL=
VISION_MODEL=deepseek-flash
# VISION_MAX_EDGE=1024
