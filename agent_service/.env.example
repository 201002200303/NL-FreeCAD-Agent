# LLM Provider（主模型，可无视觉）
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Server
HOST=127.0.0.1
PORT=8765

# Debug — save LLM prompts/responses to debug_sessions/
LLM_DEBUG=0
# LLM_DEBUG_DIR=./debug_sessions

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/cad_agent.db

# Conversation
# CONVERSATION_BUDGET_CHARS=120000
# CHAT_PLAN_MODE_DEFAULT=1

# Vision（可选；主模型无视觉时单独配）
# VISION_ENABLED=0
# VISION_API_KEY=
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o
# VISION_MAX_EDGE=1024
